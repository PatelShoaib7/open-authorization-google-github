# ============================================================================
# Centralized Identity Provider (IdP) & SSO Microservice — Environment Config
# ============================================================================

NODE_ENV=development
PORT=4000
ISSUER_URL=http://localhost:4000

# Data Stores
MONGO_URI=mongodb://127.0.0.1:27017/centralized_idp
REDIS_URL=redis://127.0.0.1:6379

# Asymmetric RS256 Signing Keys (Run `npm run keygen` to generate ./keys/private.pem & ./keys/public.pem)
# In production, prefer RSA_PRIVATE_KEY_BASE64 and RSA_PUBLIC_KEY_BASE64 from secret manager
RSA_KEY_ID=
RSA_PRIVATE_KEY_PATH=./keys/private.pem
RSA_PUBLIC_KEY_PATH=./keys/public.pem
RSA_PRIVATE_KEY_BASE64=
RSA_PUBLIC_KEY_BASE64=
# Optional comma-separated base64-encoded previous public keys kept in JWKS during key rotation
RSA_PREVIOUS_PUBLIC_KEYS_BASE64=

# Token & Cookie Security
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
AUTH_CODE_TTL_SECONDS=120
SSO_SESSION_TTL_DAYS=14
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Bootstrap Allowed Origins (comma-separated, for IdP's own dashboard/admin UI)
IDP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173

# Optional external login/consent frontend URL (leave empty to use built-in IdP SSO UI)
LOGIN_UI_URL=

# Bootstrap Admin Emails (comma-separated; matching verified emails receive admin role on registration)
ADMIN_EMAILS=admin@example.com

# Upstream Social OAuth Providers (Optional in dev; required when enabling social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
